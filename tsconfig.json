{
    "compilerOptions": {
        "moduleResolution": "node",
        "ignoreDeprecations": "6.0",
        "types": [
            "node",
            "@wdio/globals/types",
            "@wdio/cucumber-framework",
            "@wdio/allure-reporter",
            "expect-webdriverio"
        ],
        "target": "es2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "rootDir": "./",
        "outDir": "./dist",
        "esModuleInterop": true,
        "strict": true
    }
}
